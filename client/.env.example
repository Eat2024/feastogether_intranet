# 複製為 .env.local 後使用（next dev 讀取）。
# Next.js 將同源 /api/:path* 代理到這個後端位址；員工頁面也在伺服器端用它確認 session。
API_PROXY_TARGET=http://localhost:3001

# 預留給後續 client-side API client 的同源 base URL。
NEXT_PUBLIC_API_BASE_URL=/api

# 隱藏維護入口（/ops-access/*）與其 API 只允許這些來源網路（逗號分隔的 CIDR，IPv4／IPv6 皆可；server-only，不加 NEXT_PUBLIC_）。
# 未設定或空字串＝維護登入停用；格式錯誤時 client 所有請求回 500。client IP 只看 X-Real-IP（正式環境由主機 Nginx 覆寫），
# 本機沒有 Nginx，手動驗證要自帶 header，例如 curl -H 'X-Real-IP: 203.0.113.10'。下列為文件用位址。
SUPER_USER_ALLOWED_CIDRS=203.0.113.0/24,2001:db8::/32
