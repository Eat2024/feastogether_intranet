PORT=3001

CORS_ORIGIN=http://localhost:3000
# 電子簽前端 origin + 可 iframe 嵌入電子簽的主平台 origin（scheme 須與主平台實際網址一致，例如 http://portal...）。
# 主平台只用於 frame-ancestors／postMessage；瀏覽器標明跨站（Sec-Fetch-Site）的異動請求一律拒絕。
AUTH_TRUSTED_ORIGINS=http://localhost:3000,https://portal.example.internal

DB_MYSQL_HOST=127.0.0.1
DB_MYSQL_PORT=3306
DB_MYSQL_USER=root
DB_MYSQL_PASS=
DB_MYSQL_DB=feastogether_intranet
DB_MYSQL_POOL_MAX=10
# TLS（選填）：DB_MYSQL_SSL=true|skip-verify，或 DB_MYSQL_SSL_CA_B64=<base64 CA bundle>

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ── Electronic signature files ─────────────────────────────
# development/test/staging: local；production: s3
ESIGN_STORAGE_DRIVER=local
ESIGN_STORAGE_ROOT=/absolute/private/esign-files
# production only；ZIP 匯出需要 bucket Versioning=Enabled，不能使用 Suspended/null version
# 既有 PDF 儲存行為不變；版本讀刪與清理 IAM 見 Spec009 implementation-notes-s3.md
ESIGN_S3_BUCKET=<private-s3-bucket>
AWS_REGION=ap-northeast-1

# ── External signing invitation ────────────────────────────
EXTERNAL_SIGNING_ORIGIN=http://localhost:3000
ESIGN_INVITATION_ENCRYPTION_KEY_B64=<base64-32-random-bytes>
# development/staging/production: smtp；test: fake
ESIGN_MAIL_DRIVER=smtp
# 公司 Gmail SMTP：587 埠以 STARTTLS 連線，因此 SMTP_SECURE=false（不使用 465 直接 TLS）。
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=einvoice@eatogether.com.tw
# 填入寄件帳號的 Google 應用程式密碼（不是登入密碼），不可提交至版本控制；
# SMTP_USER 與 SMTP_PASSWORD 須同時設定，否則啟動失敗。
SMTP_PASSWORD=
SMTP_FROM=einvoice@eatogether.com.tw
# 改寄本機 Mailpit（僅 development）：SMTP_HOST=127.0.0.1、SMTP_PORT=1025、SMTP_SECURE=false，SMTP_USER 與 SMTP_PASSWORD 都留空。
# staging/production 必須設定 SMTP_USER 與 SMTP_PASSWORD，且一律加密：SMTP_SECURE=true 為直接 TLS，
# SMTP_SECURE=false 時強制 STARTTLS，無法加密就不寄出；帳密由部署環境提供。

# 帳密登入沿用既有饗賓 API 連線設定（值由部署環境提供）
FEASTOGETHER_BASE_URL=
FEASTOGETHER_API_KEY=

# ── Auth ────────────────────────────────────────────────────
DEVMOD=false

# 主平台 WebView SSO（正式值由部署環境提供；公鑰為 PEM 的 base64）
WEBVIEW_JWT_ISSUER=feastogether-main-platform
WEBVIEW_JWT_AUDIENCE=feastogether-esign
WEBVIEW_JWT_PUBLIC_KEY_B64=<base64-public-key-pem>
WEBVIEW_LAUNCH_ORIGIN=https://esign.example.internal

# 預留 OAuth（目前登入頁使用帳密；全部留空不影響帳密登入與 WebView SSO，設定不完整會拒絕啟動）
# AUTH_TRUSTED_ORIGINS 須包含電子簽前端 origin，才能接受登入 POST。
# 回呼網址須在統一登入平台註冊，與此設定完全一致。
OAUTH_ISSUER=
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:3000/oauth/callback
OAUTH_LOGOUT_URL=
OAUTH_TOKEN_ENCRYPTION_KEY=
