PORT=3001

CORS_ORIGIN=http://localhost:3000
# 登入／登出／OAuth 回呼的 Origin 允許清單（逗號分隔；跨站防護）。未設時退回 CORS_ORIGIN。
# AUTH_TRUSTED_ORIGINS=http://localhost:3000

DB_MYSQL_HOST=127.0.0.1
DB_MYSQL_PORT=3306
DB_MYSQL_USER=root
DB_MYSQL_PASS=
DB_MYSQL_DB=feastogether_intranet
DB_MYSQL_POOL_MAX=10
# TLS（選填）：DB_MYSQL_SSL=true|skip-verify，或 DB_MYSQL_SSL_CA_B64=<base64 CA bundle>

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
# REDIS_DB=0

# ── Auth / RBAC ─────────────────────────────────────────────
JWT_SECRET=change-me-please-use-a-long-random-secret
# 開發者登入：true = 登入頁出現「開發者登入」，免統一登入直接以超級管理員進入系統
# （帳號 dev-admin，綁 ADMIN）。開啟時可不設定下方 OAUTH_*。
# 僅本機開發使用；NODE_ENV=production / staging 時設為 true 會讓 server 啟動失敗。
DEVMOD=false
# 初始管理員的員工編號：pnpm seed:rbac 會將此員編綁定 ADMIN 角色，
# 該員工以統一登入登入後即具管理權限（登入只有統一登入一種方式）
SUPER_ADMIN_EMPID=

# 饗賓 API（帳號管理「加入同仁」的員工查詢）
FEASTOGETHER_BASE_URL=http://portaluat-api.feastogether.com.tw
FEASTOGETHER_API_KEY=

# 饗賓 OAuth／OIDC 統一登入：以下全部必填，開機時驗證，缺值或格式錯誤即啟動失敗
# （DEVMOD=true 時可全部留空，只用開發者登入）
# 受信任 issuer（https；僅本機 loopback 可用 http），Discovery 由此取得各 endpoint
OAUTH_ISSUER=
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
# 固定公開 origin + /oauth/callback，須與上游註冊值完全相同，不得含 query
OAUTH_REDIRECT_URI=http://localhost:3000/oauth/callback
# 上游自訂 /logout（與 issuer 同 origin）；不是 OIDC end_session
OAUTH_LOGOUT_URL=
# refresh token 存 Redis 前的 AES-256-GCM 金鑰：base64 的 32 bytes
#   產生：node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
OAUTH_TOKEN_ENCRYPTION_KEY=

# ── Logging ────────────────────────────────────────────────
LOG_LEVEL=debug
LOG_SLOW_MS=1000
