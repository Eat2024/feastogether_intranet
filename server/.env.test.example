# 測試環境變數範本（進版控）。複製為 .env.test 後依本機調整。
# 與 .env 同一台 MySQL，只換 database 名為 feastogether_intranet_test（可被 truncate/重建）。
PORT=3001

DB_MYSQL_HOST=127.0.0.1
DB_MYSQL_PORT=3306
DB_MYSQL_USER=root
DB_MYSQL_PASS=
DB_MYSQL_DB=feastogether_intranet_test
DB_MYSQL_POOL_MAX=2

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=1

JWT_SECRET=test-secret-0123456789abcdef0123456789abcdef
# 開發者登入預設關閉（明確寫出，避免沿用 .env 的本機值）；需要時由測試自行開啟
DEVMOD=false

SUPER_ADMIN_EMPID=test_admin

FEASTOGETHER_BASE_URL=http://localhost
FEASTOGETHER_API_KEY=test-key

# 統一登入（開機必填）：e2e 以 openid-client 替身執行，不連真實上游，填合成值即可
OAUTH_ISSUER=https://auth.example.com
OAUTH_CLIENT_ID=test-client
OAUTH_CLIENT_SECRET=test-only-not-a-secret
OAUTH_REDIRECT_URI=http://localhost:3000/oauth/callback
OAUTH_LOGOUT_URL=https://auth.example.com/logout
OAUTH_TOKEN_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

LOG_LEVEL=warn
LOG_SLOW_MS=1000
