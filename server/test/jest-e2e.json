{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": "(?:^|/)(?:internal-email-copy|internal-email-signing|internal-email-initiation|esign-employee-email-checks|esign-candidate-resolution|esign-document-delivery-security|esign-reminders|esign-signer-management|esign-export|esign-rejection|esign-draft-settings|org-chart|oauth-runtime|oauth-login|password-login|request-id|api-coverage|dev-login|webview-session|core-esign-flow|core-esign-flow-queue|core-esign-flow-scale)\\.e2e-spec\\.ts$",
  "testPathIgnorePatterns": [
    "/node_modules/"
  ],
  "globalSetup": "<rootDir>/test/global-setup.ts",
  "setupFiles": [
    "<rootDir>/test/setup-e2e.ts"
  ],
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^#app/(.*)$": "<rootDir>/src/$1",
    "^openid-client$": "<rootDir>/test/stubs/openid-client.stub.ts"
  }
}
