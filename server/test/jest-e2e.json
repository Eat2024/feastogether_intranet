{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": "(?:^|/)(?:esign-initiation-reconnect|esign-initiation-query|esign-initiation-recovery|esign-initiation-capacity|esign-initiation-acceptance|esign-document-list-scale|esign-audit-batch|signer-batch-insert|notification-bulk-insert|portal-user-import|portal-user-recovery|export-retention|esign-department-creation|esign-department-visibility|mail-whitelist-worker|mail-whitelist-runtime|mail-whitelist-otp|mail-whitelist-recovery|internal-portal-signing|internal-portal-completion|internal-group-reminders|internal-group-notifications|internal-email-capacity|internal-email-copy|internal-email-signing|internal-email-initiation|esign-candidate-resolution|esign-document-delivery-security|esign-reminders|esign-signer-management|esign-export|esign-export-history|esign-rejection|esign-draft-settings|org-chart|oauth-runtime|oauth-login|password-login|request-id|api-coverage|dev-login|webview-session|core-esign-flow|core-esign-flow-queue|core-esign-flow-scale)\\.e2e-spec\\.ts$",
  "testPathIgnorePatterns": [
    "/node_modules/"
  ],
  "globalSetup": "<rootDir>/test/global-setup.ts",
  "setupFiles": [
    "<rootDir>/test/setup-e2e.ts"
  ],
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^#app/(.*)$": "<rootDir>/src/$1",
    "^openid-client$": "<rootDir>/test/stubs/openid-client.stub.ts"
  }
}
