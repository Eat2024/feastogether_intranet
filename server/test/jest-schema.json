{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": "schema-(?:migration|constraints)\\.e2e-spec\\.ts$",
  "testPathIgnorePatterns": ["/node_modules/"],
  "setupFiles": ["<rootDir>/test/setup-e2e.ts"],
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^#app/(.*)$": "<rootDir>/src/$1"
  }
}
