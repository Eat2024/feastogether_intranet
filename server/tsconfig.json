{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "customConditions": ["development"], //package.json => "development": "./src/*.ts"
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "baseUrl": "./",
    "incremental": false,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false
  },
  "exclude": ["node_modules", "dist", "test"],
  "ts-node": {
    "//": "ts-node 須沿用 nodenext + development 條件，#app/* 才能解析到 ./src/*.ts（classic node 解析不認 imports map）",
    "transpileOnly": true,
    "compilerOptions": {
      "module": "nodenext",
      "moduleResolution": "nodenext",
      "customConditions": ["development"],
      "resolvePackageJsonExports": true
    }
  }
}
