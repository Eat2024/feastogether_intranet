{
  "openapi": "3.1.0",
  "info": {
    "title": "Intranet Spec 027 維護登入與會話增量契約",
    "version": "0.1.0",
    "description": "已依 027 實作校正（027-08）；僅列新增與修改操作。OAuth／WebView路徑沿原契約，POST /api/auth/login移除回404。Cache-Control: no-store 由 handler 設定，只出現在成功回應與 handler 內的錯誤；guard 與框架層提前拒絕的回應（Origin、限流、入口、會話驗證、body 上限）不帶 Cache-Control。完整行為見api-behavior.md。"
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "本機Next同源API代理；不是已部署服務宣告"
    }
  ],
  "paths": {
    "/api/auth/super-user-entries/{entryKey}": {
      "get": {
        "operationId": "getSuperUserEntryAvailability",
        "summary": "驗證已知維護入口位置，不列出當前入口",
        "security": [],
        "parameters": [
          {
            "name": "entryKey",
            "in": "path",
            "required": true,
            "description": "已知入口位置；不能單獨授權，不得記入一般log。",
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{43}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "有效位置；不設cookie、不寫DB",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                },
                "description": "固定no-store"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data",
                    "timestamp"
                  ],
                  "properties": {
                    "success": {
                      "const": true
                    },
                    "data": {
                      "type": "object",
                      "required": [
                        "available"
                      ],
                      "properties": {
                        "available": {
                          "const": true
                        }
                      },
                      "additionalProperties": false
                    },
                    "timestamp": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "入口不存在、已輪換或格式不符",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                },
                "example": {
                  "success": false,
                  "error": {
                    "code": "NOT_FOUND",
                    "message": "找不到請求的資源"
                  },
                  "timestamp": "2026-11-04T00:00:00Z"
                }
              }
            }
          },
          "503": {
            "description": "尚未初始化或入口已停用回 AUTH_SUPER_USER_UNAVAILABLE；DB 不可用回 AUTH_DB_UNAVAILABLE（登入服務暫時無法使用）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                },
                "example": {
                  "success": false,
                  "error": {
                    "code": "AUTH_SUPER_USER_UNAVAILABLE",
                    "message": "維護登入暫時無法使用"
                  },
                  "timestamp": "2026-11-04T00:00:00Z"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/super-user-entries/{entryKey}/sessions": {
      "post": {
        "operationId": "createSuperUserSession",
        "summary": "驗證專用帳密並原子替換目前瀏覽器會話",
        "description": "可攜帶既有session cookie但不是必要認證；Origin、IP限流與目前入口都需驗證。不得自動重試。輪換先commit則舊入口404；並發替換失敗409且不Set-Cookie。",
        "security": [],
        "parameters": [
          {
            "name": "entryKey",
            "in": "path",
            "required": true,
            "description": "已知入口位置；不能單獨授權，不得記入一般log。",
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{43}$"
            }
          },
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "精確比對受信任前端origin；Sec-Fetch-Site須同源，特殊null規則沿既有OriginGuard。"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SuperUserLogin"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "維護登入成功；user為null，不回token",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                },
                "description": "固定no-store"
              },
              "Set-Cookie": {
                "schema": {
                  "type": "string"
                },
                "description": "FT_ESIGN_SESSION；HttpOnly、Path=/、host-only，maxAge28800；正式Secure/SameSite=None，本機Lax。只在commit後送出。"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data",
                    "timestamp"
                  ],
                  "properties": {
                    "success": {
                      "const": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/SuperUserSession"
                    },
                    "timestamp": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "已知入口的輸入不合法；message 為欄位驗證訊息",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                },
                "description": "固定no-store"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                },
                "example": {
                  "success": false,
                  "error": {
                    "code": "INVALID_REQUEST",
                    "message": "帳號須為 1～128 字元"
                  },
                  "timestamp": "2026-11-04T00:00:00Z"
                }
              }
            }
          },
          "401": {
            "description": "登入憑證無效",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                },
                "description": "固定no-store"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                },
                "example": {
                  "success": false,
                  "error": {
                    "code": "AUTH_SUPER_USER_CREDENTIALS_INVALID",
                    "message": "帳號或密碼錯誤"
                  },
                  "timestamp": "2026-11-04T00:00:00Z"
                }
              }
            }
          },
          "403": {
            "description": "請求來源不允許",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                },
                "example": {
                  "success": false,
                  "error": {
                    "code": "CSRF_ORIGIN_REJECTED",
                    "message": "請求來源不允許"
                  },
                  "timestamp": "2026-11-04T00:00:00Z"
                }
              }
            }
          },
          "404": {
            "description": "入口不存在、已輪換或格式不符；早於 body 驗證",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                },
                "example": {
                  "success": false,
                  "error": {
                    "code": "NOT_FOUND",
                    "message": "找不到請求的資源"
                  },
                  "timestamp": "2026-11-04T00:00:00Z"
                }
              }
            }
          },
          "409": {
            "description": "登入身分已更新，請重新整理",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                },
                "description": "固定no-store"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                },
                "example": {
                  "success": false,
                  "error": {
                    "code": "AUTH_SESSION_REPLACED",
                    "message": "登入身分已更新，請重新整理"
                  },
                  "timestamp": "2026-11-04T00:00:00Z"
                }
              }
            }
          },
          "413": {
            "description": "body 超過 8 KiB",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                },
                "example": {
                  "success": false,
                  "error": {
                    "code": "INVALID_REQUEST",
                    "message": "請求內容超過大小限制"
                  },
                  "timestamp": "2026-11-04T00:00:00Z"
                }
              }
            }
          },
          "429": {
            "description": "同一 IP 60 秒 10 次或 300 秒 50 次；不隨 entryKey 變動，早於入口檢查",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer",
                  "minimum": 1
                },
                "description": "等待秒數"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                },
                "example": {
                  "success": false,
                  "error": {
                    "code": "REFUSE_SERVICE",
                    "message": "系統拒絕服務，請聯絡IT人員"
                  },
                  "timestamp": "2026-11-04T00:00:00Z"
                }
              }
            }
          },
          "503": {
            "description": "尚未初始化、本機帳密設定不是啟用版本、無法取得 client IP 或限流儲存不可用回 AUTH_SUPER_USER_UNAVAILABLE；DB 不可用回 AUTH_DB_UNAVAILABLE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                },
                "example": {
                  "success": false,
                  "error": {
                    "code": "AUTH_SUPER_USER_UNAVAILABLE",
                    "message": "維護登入暫時無法使用"
                  },
                  "timestamp": "2026-11-04T00:00:00Z"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/session": {
      "get": {
        "operationId": "getCurrentSession",
        "summary": "取得目前員工或維護身分，保留員工user欄位相容",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "有效身分",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                },
                "description": "固定no-store"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data",
                    "timestamp"
                  ],
                  "properties": {
                    "success": {
                      "const": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/SessionView"
                    },
                    "timestamp": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "沒有 cookie 時 message 為「請先登入」；會話不存在、過期、已撤銷或已被替換時為「登入已失效，請重新登入」",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                },
                "example": {
                  "success": false,
                  "error": {
                    "code": "UNAUTHORIZED",
                    "message": "登入已失效，請重新登入"
                  },
                  "timestamp": "2026-11-04T00:00:00Z"
                }
              }
            }
          },
          "503": {
            "description": "Super user 會話：本機帳密設定不是啟用版本或入口已停用回 AUTH_SUPER_USER_UNAVAILABLE；DB 不可用回 AUTH_DB_UNAVAILABLE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                },
                "example": {
                  "success": false,
                  "error": {
                    "code": "AUTH_SUPER_USER_UNAVAILABLE",
                    "message": "維護登入暫時無法使用"
                  },
                  "timestamp": "2026-11-04T00:00:00Z"
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "deleteCurrentSession",
        "summary": "冪等撤銷目前會話並清cookie，不恢復舊身分",
        "security": [],
        "description": "沿既有OriginGuard；缺少cookie亦成功，DB故障可503。清cookie屬性須與建立時一致。",
        "responses": {
          "200": {
            "description": "登出完成",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                },
                "description": "固定no-store"
              },
              "Set-Cookie": {
                "schema": {
                  "type": "string"
                },
                "description": "清除FT_ESIGN_SESSION及適用的OAuth交易cookie；Path、Secure、SameSite與建立時一致，Max-Age=0／過去Expires，不建立新session。"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data",
                    "timestamp"
                  ],
                  "properties": {
                    "success": {
                      "const": true
                    },
                    "data": {
                      "type": "object",
                      "required": [
                        "localLogout"
                      ],
                      "properties": {
                        "localLogout": {
                          "const": "completed"
                        }
                      }
                    },
                    "timestamp": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "請求來源不允許",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                },
                "example": {
                  "success": false,
                  "error": {
                    "code": "CSRF_ORIGIN_REJECTED",
                    "message": "請求來源不允許"
                  },
                  "timestamp": "2026-11-04T00:00:00Z"
                }
              }
            }
          },
          "503": {
            "description": "撤銷失敗；不清 cookie，會話仍有效，可重試",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                },
                "description": "固定no-store"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                },
                "example": {
                  "success": false,
                  "error": {
                    "code": "AUTH_DB_UNAVAILABLE",
                    "message": "登入服務暫時無法使用"
                  },
                  "timestamp": "2026-11-04T00:00:00Z"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "FT_ESIGN_SESSION"
      }
    },
    "schemas": {
      "ErrorEnvelope": {
        "type": "object",
        "required": [
          "success",
          "error",
          "timestamp"
        ],
        "properties": {
          "success": {
            "const": false
          },
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                ]
              }
            }
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "EmployeeUser": {
        "type": "object",
        "required": [
          "id",
          "empId",
          "name",
          "departmentName",
          "titleName",
          "lastLoginAt"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "empId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "departmentName": {
            "type": [
              "string",
              "null"
            ]
          },
          "titleName": {
            "type": [
              "string",
              "null"
            ]
          },
          "lastLoginAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      },
      "EmployeeSession": {
        "type": "object",
        "required": [
          "actor",
          "user",
          "expiresAt"
        ],
        "properties": {
          "actor": {
            "type": "object",
            "required": [
              "kind",
              "userId"
            ],
            "properties": {
              "kind": {
                "const": "employee"
              },
              "userId": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "user": {
            "$ref": "#/components/schemas/EmployeeUser"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "SuperUserSession": {
        "type": "object",
        "required": [
          "actor",
          "user",
          "expiresAt"
        ],
        "properties": {
          "actor": {
            "type": "object",
            "required": [
              "kind",
              "displayName"
            ],
            "properties": {
              "kind": {
                "const": "super_user"
              },
              "displayName": {
                "const": "Super user"
              }
            }
          },
          "user": {
            "type": "null"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "SessionView": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/EmployeeSession"
          },
          {
            "$ref": "#/components/schemas/SuperUserSession"
          }
        ]
      },
      "SuperUserLogin": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "account",
          "password"
        ],
        "properties": {
          "account": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "password": {
            "type": "string",
            "format": "password",
            "writeOnly": true,
            "minLength": 1,
            "maxLength": 1024,
            "description": "另驗UTF-8總長度最多1024 bytes；不trim或normalize。"
          }
        }
      }
    }
  }
}
